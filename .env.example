# V1.3B DeepSeek Live 模式使用。请复制为 .env，并填写真实密钥。
# .env 已被 Git 忽略；不要把真实密钥提交到仓库或写入命令行日志。
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# V1.5 百度智能云官方“百度搜索”Live模式使用。
SEARCH_PROVIDER=baidu
BAIDU_SEARCH_API_KEY=your_baidu_search_api_key_here
BAIDU_SEARCH_BASE_URL=https://qianfan.baidubce.com/v2/ai_search/web_search
# 官方接口定义与通用API Key文档使用Authorization；如控制台在线调试明确给出
# X-Appbuilder-Authorization，可显式修改。程序每次只发送一个鉴权头，不自动双发。
BAIDU_SEARCH_AUTH_HEADER=Authorization
